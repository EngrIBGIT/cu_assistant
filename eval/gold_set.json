  "author_role": "QA/QC Engineer",
  "description": "Pre-registered evaluation set for CU Route Assistant. Frozen and committed BEFORE any implementation existed. Every expected answer is traceable to a public URL captured during the Stage 1 audit. Do not edit to fix a failing case; log a removal only if a case is genuinely ambiguous, with reason and signature.",
  "scoring": {
    "routing_accuracy": "fraction of cases with intent=route where expected_route_id is in the top-3 returned route_ids",
    "answer_accuracy": "fraction of cases with intent=answer where all expected_answer_contains substrings are present in the response AND expected_citations are all present",
    "refusal_correctness": "fraction of cases with expected_refusal=true where the response refuses AND none of the forbidden strings appear",
    "groundedness": "fraction of factual claims carrying a citation that resolves to a real source_url in the corpus provenance table. Target 100%."
  },
  "integrity_notes": [
    "must_not_contain entries are checked literally, case-insensitively.",
    "forbidden_patterns entries are Python regular expressions checked against the response.",
    "Fee questions deliberately have NO expected numeric answer, because Cosmopolitan University does not publish fee figures on any page reachable at audit time. A correct response routes to Admissions and states that the figure is not published. Any invented amount is a critical failure."
  ],
